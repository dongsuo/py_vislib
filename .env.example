# Copy to .env for local dev, or set these on Render's dashboard / render.yaml.
# DO NOT commit real secret values — this file is a template only.

DJANGO_SETTINGS_MODULE=py_vislib.settings.prod

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

DEBUG=False
ALLOWED_HOSTS=api.pxlab.eu.org,api.v11nlab.com,api.vislib.best,dev.vislib.best,.onrender.com

# Neon PostgreSQL connection string (from your Neon dashboard)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# AES key used to encrypt users' external DB passwords. MUST match the value
# originally used, or stored SourceDataBase.password values won't decrypt.
CRYPT_KEY=replace-with-existing-prod-crypt-key
